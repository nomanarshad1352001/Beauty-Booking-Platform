# Solvé Studio Environment Variables
# Copy this file to .env.local and fill in your values

# ─── Payment Processing ───────────────────────────────────────
# Stripe API Keys (https://dashboard.stripe.com/apikeys)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
# Note: Secret key should be stored server-side only

# ─── Booking Software Integrations ────────────────────────────
# Mangomint API (https://www.mangomint.com/api)
VITE_MANGOMINT_API_KEY=your_mangomint_api_key

# Boulevard API (https://developers.joinblvd.com/)
VITE_BOULEVARD_API_KEY=your_boulevard_api_key

# Vagaro API (https://www.vagaro.com/pro/apidocs)
VITE_VAGARO_API_KEY=your_vagaro_api_key

# GlossGenius API
VITE_GLOSSGENIUS_API_KEY=your_glossgenius_api_key

# ─── Marketing & Communications ───────────────────────────────
# Klaviyo API (https://developers.klaviyo.com/)
VITE_KLAVIYO_API_KEY=your_klaviyo_api_key
VITE_KLAVIYO_LIST_ID=your_list_id

# ─── Database (Production) ────────────────────────────────────
# Supabase (https://supabase.com)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ─── Optional ─────────────────────────────────────────────────
# Google Analytics
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Sentry Error Tracking
VITE_SENTRY_DSN=https://your-sentry-dsn
